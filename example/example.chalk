let a: 10;
let b: 3;
let c: 7;

let sum: a + b + c;
let diff: a - b;
let product: a * b * c;

let nested: (a + b) * (c - 2);
let power: 2 ^ 3 ^ 2;
let negated: -a + b * c;

let compound: a * a + b * b + c * c;
let mixed: (a + b) ^ 2 - (a - b) ^ 2;
let deep: ((a + b) * c - diff) ^ 2 / product + negated;

print: sum;
print: diff;
print: product;
print: nested;
print: power;
print: negated;
print: compound;
print: mixed;
print: deep;
print: sum + product - nested;
print: (compound + mixed) * 2;
print: a ^ 2 + b ^ 2 + c ^ 2 - compound;

